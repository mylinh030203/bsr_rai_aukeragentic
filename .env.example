# Copy to .env and fill in for a real deployment. Never commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# production refuses to start without a real secret and issues Secure cookies,
# so serve it behind HTTPS. `docker compose up` uses this production posture by
# default; the seeded development workspace is a separate overlay with its own
# database volume (see compose.demo.yml).
BSR_ENV=production
BSR_SECRET_KEY=replace-me-with-a-long-random-value

# Persistent location for the SQLite database (file, WAL and SHM live beside it).
BSR_DATABASE=/data/bsr.db

# Keep demo data out of a real deployment. 1 seeds the synthetic workspace.
BSR_SEED_ON_START=0

# waitress bind address; most platforms inject PORT instead.
BSR_HOST=0.0.0.0
BSR_PORT=8000
BSR_THREADS=4

# Every abuse limiter stores its counter in SQLite, so limits stay exact with
# several threads or processes instead of multiplying with the worker count.
BSR_RATE_LIMIT_LOGIN=10
BSR_RATE_LIMIT_ASSISTANT=20
BSR_RATE_LIMIT_UPLOAD=10
BSR_RATE_LIMIT_EXPORT=10
